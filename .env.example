# Copy to .env and fill in. Every variable from PRD Section 16.

# MongoDB Atlas, one URI per database user (PRD 8.4).
MONGODB_URI_GATE=
MONGODB_URI_BANK=
MONGODB_URI_FINTECH=
MONGODB_URI_REVIEWER=

# WebAuthn relying party. Passkeys registered under one RP ID do not work under another.
RP_ID=localhost
# Comma-separated: the gate pages and the story app (Vite).
ORIGIN=http://localhost:3000,http://localhost:5173

# Gate signing key pair. Generate with: npm run keys
GATE_ED25519_PRIVATE_KEY=
GATE_ED25519_PUBLIC_KEY=

# Random secrets. Generate each with: openssl rand -base64 32
SESSION_SECRET=
REVIEWER_TOKEN=
ENROLL_SECRET=

# 1 lets the software test authenticator approve warrants (tests and eval only).
AWP_ALLOW_TEST_AUTHENTICATOR=0

# Per-instance database prefix (max_, pro_, jackson_). Empty for the demo databases.
AWP_DB_PREFIX=

# 1 makes the ledger routes serve test/fixtures/events.json instead of the database.
AWP_FIXTURES=0

# Optional integrations (P1). Features hide themselves when a key is absent.
ANTHROPIC_API_KEY=
AWP_LLM_MODEL=claude-sonnet-5-5
ELEVENLABS_API_KEY=
