{
  "name": "agent-warrant-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Warrant Protocol: signed, enforceable authority for AI agents",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:gate": "tsx watch src/gate/server.ts",
    "dev:bank": "INSTITUTION=bank tsx watch src/institutions/server.ts",
    "dev:fintech": "INSTITUTION=fintech tsx watch src/institutions/server.ts",
    "test": "tsc --noEmit && tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "setup-db": "tsx scripts/setup-db.ts",
    "setup-search": "tsx scripts/setup-search.ts",
    "seed": "tsx scripts/seed.ts",
    "agent": "tsx src/agent/run.ts",
    "eval": "tsx scripts/eval.ts",
    "verify-chain": "tsx scripts/verify-chain.ts",
    "keys": "tsx scripts/keys.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "canonicalize": "^5.1.0",
    "fastify": "^5.12.8",
    "mongodb": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
